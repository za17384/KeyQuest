# Rename this file to ".env" and paste your key below.
# Get a free key at https://console.groq.com/keys
# The game works without it, but AI-generated story and drills stay off.
GROQ_API_KEY=

# Optional overrides
GROQ_MODEL=openai/gpt-oss-20b
KQ_DB_PATH=keystroke_quest.db
# Optional: public site URL used in social-preview tags (Render sets this automatically)
# PUBLIC_URL=https://your-app.onrender.com
